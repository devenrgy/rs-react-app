{
	"trailingComma": "none",
	"tabWidth": 2,
	"semi": false,
	"useTabs": true,
	"arrowParens": "avoid",
	"quoteProps": "consistent",
	"endOfLine": "lf",
	"jsxSingleQuote": true,
	"printWidth": 120,
	"singleQuote": true,
	"plugins": ["prettier-plugin-tailwindcss"],
	"tailwindStylesheet": "src/global.css"
}
